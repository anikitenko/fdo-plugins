{
  "name": "fdo-remote-commands",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "VM-scoped command batches over host-managed SSH",
  "source": "index.ts",
  "main": "dist/index.cjs",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node scripts/host-tooling.mjs test",
    "test:dom": "node scripts/host-tooling.mjs test:dom",
    "test:host": "node scripts/host-tooling.mjs test:host",
    "build": "node scripts/host-tooling.mjs build",
    "test:bundle": "node tests/bundle-smoke.cjs",
    "test:deployment": "node scripts/host-tooling.mjs test:deployment",
    "verify": "npm run typecheck && npm run test:host && npm run test:dom && npm run build && npm run test:deployment"
  },
  "engines": { "node": ">=22.18" },
  "dependencies": { "@anikitenko/fdo-sdk": "^1.8.2" },
  "devDependencies": { "@types/node": "^22.0.0", "esbuild": "^0.25.0", "jsdom": "^27.4.0", "typescript": "^5.9.3" }
}
